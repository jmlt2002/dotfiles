{
  "layer": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,

  "font-family": "Fira Mono, JetBrains Mono, monospace",

  "modules-left": [
    "custom/appmenuicon",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "custom/media"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "bluetooth",
    "tray",
    "clock"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate"
  },

  "custom/empty": { "format": "" },

  "custom/appmenu": {
    "format": "Apps",
    "on-click": "shutdown now",
    "tooltip": false
  },

  "custom/appmenuicon": {
    "format": "",
    "on-click": "wlogout -b 2",
    "tooltip": false
  },

  "custom/media": {
        "exec": "playerctl -p spotify metadata --format '  {{artist}} - {{title}}'",  
        "interval": 1,  
        "on-click": "playerctl -p spotify play-pause",  
        "on-scroll-up": "playerctl -p spotify next",  
        "on-scroll-down": "playerctl -p spotify previous",  
        "max-length": 50,  
        "format-icons": {  
            "Playing": "",  
            "Paused": ""  
        },  
        "on-click-middle": "spotify"
    }, 

  "tray": {
    "icon-size": 17,
    "spacing": 10
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "",
    "on-click-middle": "pavucontrol",
    "on-click": "pactl set-sink-mute alsa_output.pci-0000_02_00.6.analog-stereo toggle",
    "on-click-right": "pactl set-source-mute alsa_input.pci-0000_02_00.6.analog-stereo toggle",
    "format-icons": {
      "default": [" "]
    }
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "  Disconnected",
    "on-click": "nmtui",
    "tooltip": true
  },

  "custom/space-right": {
    "format": "  ",
    "tooltip": false
  },

  "bluetooth": {
    "format": "",
    "on-click": "blueman-manager",
    "tooltip": true
  },

  "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": " {:%d/%m/%Y}"
  }
}